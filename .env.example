# ============================================================
# PrepAI Environment Configuration
# ============================================================

# GEMINI_API_KEY: Required for AI interview questioning and evaluations.
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
# For local development: Set in .env or .env.local
# For Vercel production: Add as an Environment Variable in Vercel Project Settings (Do NOT prefix with VITE_)
GEMINI_API_KEY="your_gemini_api_key_here"

# AUTH_SECRET: Optional secret key for signing session tokens.
# A default fallback is used if not provided.
AUTH_SECRET="your_long_random_auth_secret_here"
